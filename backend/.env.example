PORT=3000
FRONTEND_URL=http://localhost:5173

# ──────────────────────────────────────────────────────────────
# Base de datos — SQL Server con Windows Authentication (ODBC)
# ──────────────────────────────────────────────────────────────
DB_SERVER=localhost\SQLEXPRESS
DB_DATABASE=FastBitesDB
DB_DRIVER=msnodesqlv8
# Nombre del driver ODBC sin llaves — db.ts las agrega automáticamente.
# Para ver los drivers instalados en Windows:
#   Get-OdbcDriver | Select-Object -ExpandProperty Name
DB_ODBC_DRIVER=ODBC Driver 17 for SQL Server
DB_TRUST_SERVER_CERTIFICATE=true
DB_ENCRYPT=false
# Para SQL Authentication (usuario/contraseña) — descomentar si se usa:
# DB_USER=sa
# DB_PASSWORD=tu_password

# ──────────────────────────────────────────────────────────────
# Autenticación JWT
# ──────────────────────────────────────────────────────────────
# Clave secreta para firmar los tokens. Usar una cadena larga y aleatoria en producción.
# Ejemplo: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambia-esto-por-una-clave-segura-en-produccion
# Tiempo de expiración del token. Formatos válidos: 8h | 1d | 7d | 30m
JWT_EXPIRES_IN=8h
